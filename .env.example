# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is ignored by .gitignore.

# Supabase → Project Settings → API
# Public values: shipped to the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret. Bypasses RLS — used only in Server Actions (account
# deletion, student verification) via utils/supabase/admin.js.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Resend (https://resend.com) — transactional e-mail (student verification codes).
# The sender must use a domain verified in Resend; without one, the test sender
# onboarding@resend.dev only delivers to your own Resend account address.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Toro <no-reply@your-domain.com>"

# Where /contact form messages are delivered. Server-only, never shown on the site.
CONTACT_INBOX_EMAIL=founders@your-domain.com

# Server-only key for hashing student verification codes (HMAC-SHA256).
# Generate with: openssl rand -hex 32
VERIFICATION_CODE_SECRET=
