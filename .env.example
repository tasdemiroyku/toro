# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is ignored by .gitignore.

# Supabase → Project Settings → API
# Public values: shipped to the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret. Bypasses RLS — used only by the account deletion
# Server Action (utils/supabase/admin.js). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Resend (https://resend.com) — reserved for transactional e-mail
# (report notifications, new-message alerts). Not required to run the app yet.
RESEND_API_KEY=
